# ==============================================================================
# ClassOrbit — Environment Variables Template (Phase 0: Project Foundation)
# ==============================================================================
# This template documents the environment variables for local frontend development.
# IMPORTANT:
# - Never commit actual secret keys, API tokens, or OAuth credentials.
# - Copy this file to `.env.local` for local development overrides.

# ------------------------------------------------------------------------------
# 1. Frontend Application Configuration
# ------------------------------------------------------------------------------
NEXT_PUBLIC_APP_NAME="ClassOrbit"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_ENV="development"

